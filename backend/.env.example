# Provider: "nim" (free, default) or "anthropic"
LLM_PROVIDER=nim

# NIM (default provider — free via https://build.nvidia.com)
NVIDIA_NIM_API_KEY=nvapi-...

# Anthropic (optional fallback — only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

DATABASE_URL=sqlite:///./adeal.db
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NIM model config (optional — these are the defaults)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_INTERVIEW_MODEL=meta/llama-3.3-70b-instruct
NIM_EXTRACTION_MODEL=deepseek-ai/deepseek-r1-0528
NIM_TRADER_MODEL=deepseek-ai/deepseek-r1-0528

# Anthropic model config (only used if LLM_PROVIDER=anthropic)
DEFAULT_AGENT_MODEL=claude-opus-4-7
INTERVIEWER_MODEL=claude-opus-4-7

# Market config
MARKET_DURATION_DAYS=7
MAX_NEGOTIATION_ROUNDS=10
SCHEDULER_INTERVAL_SECONDS=30
